generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id                         String                   @id
  username                   String                   @unique
  totpMethod                 String?
  totpEncryptedSecret        String?
  totpEnrolledAt             DateTime?
  createdAt                  DateTime
  updatedAt                  DateTime
  sessions                   AuthSession[]
  analyticsImportsUploaded   AnalyticsImport[]        @relation("AnalyticsImportUploadedBy")
  analyticsImportsWithdrawn  AnalyticsImport[]        @relation("AnalyticsImportWithdrawnBy")
  analyticsRowsConfirmed     AnalyticsImportRow[]     @relation("AnalyticsImportRowConfirmedBy")
  analyticsRowsUnmatched     AnalyticsImportRow[]     @relation("AnalyticsImportRowUnmatchedBy")
  releaseAliasesConfirmed    ReleaseImportAlias[]     @relation("ReleaseImportAliasConfirmedBy")
  releaseAliasesRevoked      ReleaseImportAlias[]     @relation("ReleaseImportAliasRevokedBy")
  mappingAuditEvents         MappingAuditEvent[]
  promotionCampaignsCreated  PromotionCampaign[]      @relation("PromotionCampaignCreatedBy")
  promotionCampaignsUpdated  PromotionCampaign[]      @relation("PromotionCampaignUpdatedBy")
  campaignIntervalsCreated   CampaignActiveInterval[] @relation("CampaignIntervalCreatedBy")
  campaignIntervalsUpdated   CampaignActiveInterval[] @relation("CampaignIntervalUpdatedBy")
  campaignIntervalsConfirmed CampaignActiveInterval[] @relation("CampaignIntervalConfirmedBy")
  campaignIntervalsRejected  CampaignActiveInterval[] @relation("CampaignIntervalRejectedBy")
  campaignEventsCreated      CampaignTimelineEvent[]  @relation("CampaignEventCreatedBy")
  campaignEventsUpdated      CampaignTimelineEvent[]  @relation("CampaignEventUpdatedBy")
  campaignEvidenceCreated    CampaignEvidence[]       @relation("CampaignEvidenceCreatedBy")
  campaignAuditEvents        CampaignAuditEvent[]

  @@index([username])
}

model AuthSession {
  id                String    @id
  userId            String
  username          String
  stage             String
  factorMethod      String?
  pendingTotpSecret String?
  createdAt         DateTime
  updatedAt         DateTime
  expiresAt         DateTime
  user              AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Release {
  id                      String                      @id
  title                   String
  slug                    String                      @unique
  catalogScope            String                      @default("VVVIRUZ")
  primaryArtistProfileId  String?
  pinned                  Boolean                     @default(false)
  collaborator            Boolean                     @default(false)
  collaboratorName        String                      @default("")
  upc                     String                      @default("")
  isrc                    String                      @default("")
  coverArtId              String?
  coverArtFileName        String?
  coverArtUrl             String?
  coverArtPath            String                      @default("")
  coverArtMimeType        String?
  lyrics                  String                      @default("")
  type                    String                      @default("nerdcore")
  releaseDate             DateTime?
  conceptDetails          String                      @default("")
  publicDescription       String                      @default("")
  publicLongDescription   String                      @default("")
  languages               String                      @default("[]")
  genres                  String                      @default("[]")
  moods                   String                      @default("[]")
  inspirationContext      String                      @default("")
  themes                  String                      @default("[]")
  listenerContexts        String                      @default("[]")
  seoTitle                String                      @default("")
  metaDescription         String                      @default("")
  coverArtAltText         String                      @default("")
  socialShareTitle        String                      @default("")
  socialShareDescription  String                      @default("")
  contextualCtaLabel      String                      @default("")
  contextualCtaUrl        String                      @default("")
  spotifyUrl              String                      @default("")
  appleMusicUrl           String                      @default("")
  youtubeUrl              String                      @default("")
  isPublished             Boolean                     @default(false)
  isFeatured              Boolean                     @default(false)
  featuredVideoUrl        String                      @default("")
  publicLyricsEnabled     Boolean                     @default(false)
  lyricsRightsConfirmedAt DateTime?
  conceptComplete         Boolean                     @default(false)
  beatMade                Boolean                     @default(false)
  lyricsFinished          Boolean                     @default(false)
  recorded                Boolean                     @default(false)
  mixMastered             Boolean                     @default(false)
  published               Boolean                     @default(false)
  createdOn               DateTime
  updatedOn               DateTime
  tasks                   ReleaseTask[]
  streamingLinks          ReleaseStreamingLink[]
  copies                  CopyEntry[]
  categories              ReleaseCategoryAssignment[]
  adImportBatches         AdImportBatch[]
  adCreativeReports       AdCreativeReport[]
  adCampaignLearnings     AdCampaignLearning[]
  shortLinks              ShortLink[]
  linkHubs                LinkHub[]
  featuredPlaylists       Playlist[]                  @relation("PlaylistFeaturedRelease")
  playlists               PlaylistRelease[]
  annotations             ReleaseAnnotation[]
  breakingBarzEntries     BreakingBarzEntry[]
  fanUpdates              FanUpdate[]
  vaultItems              VaultItem[]
  artistCredits           ReleaseArtistCredit[]
  primaryArtistProfile    ArtistProfile?              @relation("PrimaryArtistReleases", fields: [primaryArtistProfileId], references: [id], onDelete: SetNull)
  artistPlacements        ArtistFeaturedItem[]        @relation("ArtistFeaturedRelease")
  trackMetricObservations TrackMetricObservation[]
  songPeriodSnapshots     SongPeriodSnapshot[]
  suggestedAnalyticsRows  AnalyticsImportRow[]        @relation("AnalyticsImportRowSuggestedRelease")
  confirmedAnalyticsRows  AnalyticsImportRow[]        @relation("AnalyticsImportRowConfirmedRelease")
  importAliases           ReleaseImportAlias[]
  promotionCampaigns      PromotionCampaign[]
  campaignTimelineEvents  CampaignTimelineEvent[]

  @@index([pinned, updatedOn])
  @@index([isPublished, releaseDate])
  @@index([isFeatured, releaseDate])
  @@index([catalogScope, isPublished, releaseDate])
  @@index([primaryArtistProfileId, updatedOn])
}

model ReleaseCategory {
  id                 String                      @id
  name               String
  slug               String                      @unique
  description        String                      @default("")
  projectType        String                      @default("series")
  artworkPath        String                      @default("")
  artworkAltText     String                      @default("")
  projectReleaseDate DateTime?
  spotifyUrl         String                      @default("")
  appleMusicUrl      String                      @default("")
  youtubeUrl         String                      @default("")
  sortOrder          Int                         @default(0)
  createdAt          DateTime
  updatedAt          DateTime
  releases           ReleaseCategoryAssignment[]

  @@index([sortOrder, name])
}

model ReleaseCategoryAssignment {
  id         String          @id
  categoryId String
  releaseId  String
  sortOrder  Int             @default(0)
  createdAt  DateTime
  updatedAt  DateTime
  category   ReleaseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  release    Release         @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([categoryId, releaseId])
  @@index([releaseId])
  @@index([categoryId, sortOrder])
}

model ReleaseTask {
  id        String   @id
  releaseId String
  text      String
  completed Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime
  updatedAt DateTime
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@index([releaseId, sortOrder])
}

model ReleaseStreamingLink {
  id        String   @id
  releaseId String
  platform  String
  url       String
  createdAt DateTime
  updatedAt DateTime
  release   Release  @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, platform])
  @@index([releaseId])
}

model CopyEntry {
  id            String               @id
  releaseId     String?
  hook          String
  caption       String
  type          String               @default("discovery-shock")
  hookType      String               @default("discovery-shock")
  contentType   String               @default("amv-lyric-edit")
  songSection   String               @default("hook")
  creativeNotes String               @default("")
  createdOn     DateTime
  updatedOn     DateTime
  archivedAt    DateTime?
  archiveReason String?
  release       Release?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  adLinks       AdCreativeCopyLink[]

  @@index([releaseId])
  @@index([hookType, contentType, songSection])
  @@index([updatedOn])
}

model AdImportBatch {
  id                 String               @id
  source             String               @default("meta")
  name               String               @default("")
  releaseId          String?
  reportingStart     DateTime?
  reportingEnd       DateTime?
  exportedAt         DateTime?
  attributionSetting String               @default("7-day click, 1-day view, 1-day engagement")
  batchType          String               @default("Rolling Snapshot")
  fileNames          String               @default("[]")
  notes              String               @default("")
  createdAt          DateTime
  updatedAt          DateTime
  release            Release?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  reports            AdCreativeReport[]
  learnings          AdCampaignLearning[]
  campaignEvidence   CampaignEvidence[]

  @@index([releaseId])
  @@index([createdAt])
  @@index([exportedAt])
  @@index([batchType])
}

model AdCreativeReport {
  id                             String               @id
  importBatchId                  String
  releaseId                      String?
  campaignName                   String?
  adSetName                      String?
  adName                         String
  adDelivery                     String?
  reportingStart                 DateTime?
  reportingEnd                   DateTime?
  spend                          Float?
  impressions                    Int?
  reach                          Int?
  frequency                      Float?
  costPerThousandAccountsReached Float?
  cpm                            Float?
  results                        Float?
  resultIndicator                String?
  costPerResult                  Float?
  linkClicks                     Int?
  cpc                            Float?
  ctr                            Float?
  clicksAll                      Int?
  ctrAll                         Float?
  cpcAll                         Float?
  landingPageViews               Int?
  costPerLandingPageView         Float?
  shopClicks                     Int?
  pageEngagement                 Int?
  postReactions                  Int?
  postComments                   Int?
  postSaves                      Int?
  postShares                     Int?
  facebookLikes                  Int?
  instagramFollows               Int?
  videoPlays                     Int?
  twoSecondContinuousPlays       Int?
  costPerTwoSecondContinuousPlay Float?
  threeSecondPlays               Int?
  costPerThreeSecondPlay         Float?
  thruPlays                      Int?
  costPerThruPlay                Float?
  video25                        Int?
  video50                        Int?
  video75                        Int?
  video95                        Int?
  video100                       Int?
  qualityRanking                 String?
  engagementRateRanking          String?
  conversionRateRanking          String?
  utmSource                      String?
  utmCampaign                    String?
  utmContent                     String?
  createdAt                      DateTime
  updatedAt                      DateTime
  importBatch                    AdImportBatch        @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  release                        Release?             @relation(fields: [releaseId], references: [id], onDelete: SetNull)
  copyLinks                      AdCreativeCopyLink[]

  @@index([importBatchId])
  @@index([releaseId])
  @@index([utmSource, utmCampaign, utmContent])
  @@index([adName, adSetName, reportingStart, reportingEnd])
}

model AdCreativeCopyLink {
  id                 String           @id
  adCreativeReportId String
  copyEntryId        String
  createdAt          DateTime
  adCreativeReport   AdCreativeReport @relation(fields: [adCreativeReportId], references: [id], onDelete: Cascade)
  copyEntry          CopyEntry        @relation(fields: [copyEntryId], references: [id], onDelete: Cascade)

  @@unique([adCreativeReportId, copyEntryId])
  @@index([copyEntryId])
}

model AdCampaignLearning {
  id                 String        @id
  importBatchId      String
  releaseId          String?
  summary            String        @default("")
  whatWorked         String        @default("")
  whatFailed         String        @default("")
  nextTest           String        @default("")
  decision           String        @default("iterate")
  reviewedAt         DateTime?
  reviewedBy         String        @default("")
  finalDecision      String        @default("")
  humanOverrideNotes String        @default("")
  createdAt          DateTime
  updatedAt          DateTime
  importBatch        AdImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  release            Release?      @relation(fields: [releaseId], references: [id], onDelete: SetNull)

  @@index([importBatchId])
  @@index([releaseId])
  @@index([updatedAt])
}

model SiteSettings {
  id             String   @id
  artistName     String   @default("vvviruz")
  tagline        String   @default("")
  shortBio       String   @default("")
  longBio        String   @default("")
  contactEmail   String   @default("")
  bookingEmail   String   @default("")
  socialLinks    String   @default("[]")
  heroText       String   @default("")
  aboutContent   String   @default("")
  linksPageItems String   @default("[]")
  siteContent    String   @default("{}")
  createdOn      DateTime
  updatedOn      DateTime
}

model Subscriber {
  id                  String         @id
  name                String         @default("")
  email               String         @unique
  source              String         @default("exclusive")
  status              String         @default("active")
  consentGiven        Boolean        @default(false)
  downloadToken       String         @unique
  unsubscribeToken    String         @unique
  createdAt           DateTime
  updatedAt           DateTime
  unsubscribedAt      DateTime?
  // Source attribution (first source preserved unless explicit Vault re-consent updates context)
  sourceUtmSource     String         @default("")
  sourceUtmMedium     String         @default("")
  sourceUtmCampaign   String         @default("")
  sourceUtmContent    String         @default("")
  sourceUtmTerm       String         @default("")
  sourceReferrer      String         @default("")
  sourceLandingPage   String         @default("")
  sourceOfferMode     String         @default("")
  sourceOfferName     String         @default("")
  sourceSignupContext String         @default("")
  sendLogs            EmailSendLog[]

  @@index([status, createdAt])
  @@index([source, status])
  @@index([sourceUtmCampaign])
  @@index([sourceOfferMode])
}

model EmailCampaign {
  id             String         @id
  subject        String
  previewText    String         @default("")
  body           String         @default("")
  ctaLabel       String         @default("")
  ctaUrl         String         @default("")
  audienceFilter String         @default("all_active")
  status         String         @default("draft")
  recipientCount Int            @default(0)
  sentAt         DateTime?
  createdAt      DateTime
  updatedAt      DateTime
  sendLogs       EmailSendLog[]

  @@index([status, createdAt])
}

model EmailSendLog {
  id                String        @id
  campaignId        String
  subscriberId      String?
  email             String
  status            String
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime
  campaign          EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  subscriber        Subscriber?   @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([subscriberId])
  @@index([status, createdAt])
}

model AnalyticsEvent {
  id                String         @id
  eventId           String?
  eventType         String
  page              String
  path              String         @default("")
  hubPath           String         @default("")
  playlistId        String?
  playlistSlug      String         @default("")
  shortLinkId       String?
  releaseId         String?
  artistProfileId   String?
  platform          String         @default("")
  entryType         String         @default("")
  linkType          String         @default("")
  linkLabel         String         @default("")
  contentType       String         @default("")
  contentId         String         @default("")
  interactionSource String         @default("")
  targetUrl         String         @default("")
  referrer          String         @default("")
  originalReferrer  String         @default("")
  userAgent         String         @default("")
  visitorId         String         @default("")
  sessionId         String         @default("")
  utmSource         String         @default("")
  utmMedium         String         @default("")
  utmCampaign       String         @default("")
  utmContent        String         @default("")
  utmTerm           String         @default("")
  fbclid            String         @default("")
  country           String         @default("")
  createdAt         DateTime
  artistProfile     ArtistProfile? @relation(fields: [artistProfileId], references: [id], onDelete: SetNull)

  @@unique([eventId, eventType])
  @@index([page, createdAt])
  @@index([eventType, createdAt])
  @@index([releaseId, createdAt])
  @@index([artistProfileId, createdAt])
  @@index([visitorId, createdAt])
  @@index([playlistId, eventType, createdAt])
  @@index([playlistId, releaseId, createdAt])
  @@index([shortLinkId, createdAt])
}

model AnalyticsImport {
  id                       String                    @id
  source                   String                    @default("SPOTIFY_FOR_ARTISTS")
  importType               String
  originalFilename         String
  fileHash                 String                    @unique
  commitIdempotencyKey     String?                   @unique
  artistProfileId          String
  uploadedById             String?
  uploadedByUsername       String                    @default("")
  uploadedAt               DateTime
  status                   String                    @default("PENDING")
  reportingTimezone        String                    @default("UTC")
  detectedPeriodStart      DateTime?
  detectedPeriodEnd        DateTime?
  userConfirmedPeriodStart DateTime?
  userConfirmedPeriodEnd   DateTime?
  periodDatesUserConfirmed Boolean                   @default(false)
  rowCount                 Int                       @default(0)
  acceptedRowCount         Int                       @default(0)
  rejectedRowCount         Int                       @default(0)
  unmatchedRowCount        Int                       @default(0)
  warningCount             Int                       @default(0)
  validationSummary        String                    @default("{}")
  metadata                 String                    @default("{}")
  normalizationVersion     Int                       @default(1)
  rawFileStorageDriver     String?
  rawFileStorageKey        String?
  rawFileSizeBytes         Int?
  rawFileExpiresAt         DateTime?
  rawFileDeletedAt         DateTime?
  acceptedAt               DateTime?
  withdrawnAt              DateTime?
  withdrawnById            String?
  withdrawalReason         String                    @default("")
  replacedByImportId       String?
  createdAt                DateTime
  updatedAt                DateTime
  artistProfile            ArtistProfile             @relation(fields: [artistProfileId], references: [id], onDelete: Restrict)
  uploadedBy               AdminUser?                @relation("AnalyticsImportUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  withdrawnBy              AdminUser?                @relation("AnalyticsImportWithdrawnBy", fields: [withdrawnById], references: [id], onDelete: SetNull)
  replacedBy               AnalyticsImport?          @relation("AnalyticsImportReplacements", fields: [replacedByImportId], references: [id], onDelete: Restrict)
  replaces                 AnalyticsImport[]         @relation("AnalyticsImportReplacements")
  artistMetricObservations ArtistMetricObservation[]
  trackMetricObservations  TrackMetricObservation[]
  songPeriodSnapshots      SongPeriodSnapshot[]
  playlistPeriodSnapshots  PlaylistPeriodSnapshot[]
  mappingRows              AnalyticsImportRow[]
  mappingAuditEvents       MappingAuditEvent[]

  @@index([source, importType])
  @@index([artistProfileId, importType, acceptedAt])
  @@index([status, acceptedAt])
  @@index([uploadedById])
  @@index([withdrawnById])
  @@index([replacedByImportId])
  @@index([rawFileExpiresAt])
}

model AnalyticsImportRow {
  id                  String              @id
  importId            String
  sourceRowNumber     Int
  exportType          String
  rowIdentityKey      String
  originalValues      String              @default("{}")
  safeDisplayValues   String              @default("{}")
  normalizedValues    String              @default("{}")
  structuralOutcome   String
  mappingStatus       String              @default("UNREVIEWED")
  mappingReason       String              @default("")
  suggestedReleaseId  String?
  confirmedReleaseId  String?
  confirmedScopeKey   String?             @unique
  mappingConfidence   String              @default("NO_MATCH")
  mappingEvidence     String              @default("{}")
  appliedAliasId      String?
  confirmedById       String?
  confirmedByUsername String              @default("")
  confirmedAt         DateTime?
  unmatchedReason     String?
  unmatchedNote       String              @default("")
  unmatchedById       String?
  unmatchedByUsername String              @default("")
  unmatchedAt         DateTime?
  mappingVersion      Int                 @default(1)
  createdAt           DateTime
  updatedAt           DateTime
  import              AnalyticsImport     @relation(fields: [importId], references: [id], onDelete: Restrict)
  suggestedRelease    Release?            @relation("AnalyticsImportRowSuggestedRelease", fields: [suggestedReleaseId], references: [id], onDelete: SetNull)
  confirmedRelease    Release?            @relation("AnalyticsImportRowConfirmedRelease", fields: [confirmedReleaseId], references: [id], onDelete: Restrict)
  appliedAlias        ReleaseImportAlias? @relation(fields: [appliedAliasId], references: [id], onDelete: SetNull)
  confirmedBy         AdminUser?          @relation("AnalyticsImportRowConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  unmatchedBy         AdminUser?          @relation("AnalyticsImportRowUnmatchedBy", fields: [unmatchedById], references: [id], onDelete: SetNull)
  songPeriodSnapshot  SongPeriodSnapshot?
  auditEvents         MappingAuditEvent[]

  @@unique([importId, sourceRowNumber])
  @@index([importId, mappingStatus])
  @@index([exportType, mappingStatus])
  @@index([mappingConfidence])
  @@index([suggestedReleaseId])
  @@index([confirmedReleaseId])
  @@index([appliedAliasId])
}

model ReleaseImportAlias {
  id                  String               @id
  source              String
  exportType          String
  exportedTitle       String
  normalizedTitle     String
  exportedReleaseDate DateTime?
  artistProfileId     String
  releaseId           String
  status              String               @default("ACTIVE")
  matchMethod         String
  evidence            String               @default("{}")
  scopeKey            String
  activeScopeKey      String?              @unique
  confirmedById       String?
  confirmedByUsername String               @default("")
  confirmedAt         DateTime
  revokedAt           DateTime?
  revokedById         String?
  revokedByUsername   String               @default("")
  revocationReason    String               @default("")
  supersededByAliasId String?
  createdAt           DateTime
  updatedAt           DateTime
  artistProfile       ArtistProfile        @relation(fields: [artistProfileId], references: [id], onDelete: Restrict)
  release             Release              @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  confirmedBy         AdminUser?           @relation("ReleaseImportAliasConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  revokedBy           AdminUser?           @relation("ReleaseImportAliasRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  supersededBy        ReleaseImportAlias?  @relation("ReleaseImportAliasSupersession", fields: [supersededByAliasId], references: [id], onDelete: Restrict)
  supersedes          ReleaseImportAlias[] @relation("ReleaseImportAliasSupersession")
  appliedRows         AnalyticsImportRow[]
  auditEvents         MappingAuditEvent[]

  @@index([artistProfileId, source, exportType, normalizedTitle])
  @@index([releaseId, status])
  @@index([scopeKey, status])
  @@index([confirmedById])
  @@index([revokedById])
  @@index([supersededByAliasId])
}

model MappingAuditEvent {
  id                    String              @id
  rowId                 String?
  importId              String?
  aliasId               String?
  action                String
  previousMappingStatus String?
  newMappingStatus      String?
  previousReleaseId     String?
  newReleaseId          String?
  reason                String              @default("")
  evidence              String              @default("{}")
  actorId               String?
  actorUsername         String              @default("")
  createdAt             DateTime
  row                   AnalyticsImportRow? @relation(fields: [rowId], references: [id], onDelete: SetNull)
  import                AnalyticsImport?    @relation(fields: [importId], references: [id], onDelete: SetNull)
  alias                 ReleaseImportAlias? @relation(fields: [aliasId], references: [id], onDelete: SetNull)
  actor                 AdminUser?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([rowId, createdAt])
  @@index([importId, createdAt])
  @@index([aliasId, createdAt])
  @@index([actorId])
}

model PromotionCampaign {
  id                   String                   @id
  artistProfileId      String
  releaseId            String
  platform             String
  name                 String
  objective            String
  status               String                   @default("DRAFT")
  notes                String                   @default("")
  externalCampaignId   String                   @default("")
  externalCampaignName String                   @default("")
  createdById          String?
  createdByUsername    String                   @default("")
  updatedById          String?
  updatedByUsername    String                   @default("")
  createdAt            DateTime
  updatedAt            DateTime
  archivedAt           DateTime?
  artistProfile        ArtistProfile            @relation(fields: [artistProfileId], references: [id], onDelete: Restrict)
  release              Release                  @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  createdBy            AdminUser?               @relation("PromotionCampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            AdminUser?               @relation("PromotionCampaignUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  activeIntervals      CampaignActiveInterval[]
  timelineEvents       CampaignTimelineEvent[]
  evidence             CampaignEvidence[]
  auditEvents          CampaignAuditEvent[]

  @@index([releaseId, status, updatedAt])
  @@index([artistProfileId, status, updatedAt])
  @@index([platform, status])
  @@index([externalCampaignId])
}

model CampaignActiveInterval {
  id                   String                  @id
  campaignId           String
  activeStartDate      DateTime
  activeEndDate        DateTime?
  timezone             String                  @default("UTC")
  sourceType           String
  confirmationStatus   String                  @default("SUGGESTED")
  evidenceId           String?
  supersedesIntervalId String?                 @unique
  notes                String                  @default("")
  correctionReason     String                  @default("")
  createdById          String?
  createdByUsername    String                  @default("")
  updatedById          String?
  updatedByUsername    String                  @default("")
  confirmedById        String?
  confirmedByUsername  String                  @default("")
  confirmedAt          DateTime?
  rejectedById         String?
  rejectedByUsername   String                  @default("")
  rejectedAt           DateTime?
  createdAt            DateTime
  updatedAt            DateTime
  campaign             PromotionCampaign       @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  evidence             CampaignEvidence?       @relation(fields: [evidenceId], references: [id], onDelete: SetNull)
  supersedes           CampaignActiveInterval? @relation("CampaignIntervalSupersession", fields: [supersedesIntervalId], references: [id], onDelete: Restrict)
  supersededBy         CampaignActiveInterval? @relation("CampaignIntervalSupersession")
  createdBy            AdminUser?              @relation("CampaignIntervalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy            AdminUser?              @relation("CampaignIntervalUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  confirmedBy          AdminUser?              @relation("CampaignIntervalConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
